{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/evento/:id",
      "destination": "/api/event-page?id=:id"
    },
    {
      "source": "/((?!api/|favicon\\.ico|favicon\\.png|_expo/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
